rules_version = '2';

// Reglas pensadas para el plan Spark:
// - tenants/{id} usa el uid del dueño como id → "¿es el dueño?" se responde sin leer documentos.
// - Cada get()/exists()/getAfter() en una regla cuenta como una lectura; solo se usan donde no hay otra opción.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    // A14: el dueño verifica su correo antes de operar (Firebase lo pone en el token).
    function emailVerified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    // Perfil de quien hace la petición (1 lectura, se reutiliza dentro de la misma petición).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A16: el dueño le quitó el acceso a este barbero (1 lectura, solo en operaciones de barbero).
    function notRevoked(tenantId) {
      return !exists(/databases/$(database)/documents/tenants/$(tenantId)/revoked/$(request.auth.uid));
    }

    // Dueño o cualquier barbero de la barbería.
    function isStaffOfTenant(tenantId) {
      return isSelf(tenantId)
        || (signedIn()
            && myProfile().get('staffRole', null) == 'BARBER'
            && myProfile().get('staffTenantId', null) == tenantId
            && notRevoked(tenantId));
    }

    // A2: barbero ligado a esta barbería y a este barbero del catálogo.
    function isBarberOf(tenantId, barberId) {
      return signedIn()
        && myProfile().get('staffRole', null) == 'BARBER'
        && myProfile().get('staffTenantId', null) == tenantId
        && myProfile().get('staffBarberId', null) == barberId
        && notRevoked(tenantId);
    }

    // ── users/{uid} ──────────────────────────────────────────────────────────
    match /users/{uid} {
      function validProfile(data) {
        return data.keys().hasOnly(['displayName', 'email', 'phone', 'staffTenantId', 'staffRole', 'createdAt'])
          && isText(data.displayName, 1, 80)
          && data.email == request.auth.token.email
          && isOptionalText(data.phone, 20)
          && data.createdAt == request.time;
      }

      // Cliente: sin rol. Dueño: su propia barbería, creada en el mismo batch (A9).
      // Nadie puede darse el rol de barbero: eso lo hará el dueño (fase 4).
      function validRole(data) {
        return (data.staffRole == null && data.staffTenantId == null)
          || (data.staffRole == 'OWNER'
              && data.staffTenantId == uid
              && getAfter(/databases/$(database)/documents/tenants/$(uid)).data.ownerUid == uid);
      }

      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validProfile(request.resource.data) && validRole(request.resource.data);
      function inviteAfter() {
        return getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.staffInviteCode)).data;
      }

      // A1/A8: un cliente (sin rol) se vuelve barbero solo con una invitación válida que usa en el mismo batch.
      function redeemsInvite() {
        return resource.data.staffRole == null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['staffTenantId', 'staffRole', 'staffBarberId', 'staffInviteCode'])
          && request.resource.data.staffRole == 'BARBER'
          && inviteAfter().usedBy == uid
          && inviteAfter().tenantId == request.resource.data.staffTenantId
          && inviteAfter().barberId == request.resource.data.staffBarberId;
      }

      // A7-b/A16: un barbero puede dejar de serlo (barbería borrada, acceso quitado o se fue). Todo o nada.
      function leavesStaff() {
        let d = request.resource.data;
        return resource.data.get('staffRole', null) == 'BARBER'
          && d.diff(resource.data).affectedKeys().hasOnly(['staffTenantId', 'staffRole', 'staffBarberId', 'staffInviteCode'])
          && d.get('staffRole', null) == null
          && d.get('staffTenantId', null) == null
          && d.get('staffBarberId', null) == null
          && d.get('staffInviteCode', null) == null;
      }

      allow update: if isSelf(uid) && (
        leavesStaff() ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone'])
          && isText(request.resource.data.displayName, 1, 80)
          && isOptionalText(request.resource.data.phone, 20))
        || redeemsInvite()
      );
      allow delete: if isSelf(uid); // A7: eliminar cuenta
    }

    // ── tenants/{ownerUid} ───────────────────────────────────────────────────
    match /tenants/{tenantId} {
      // N5: misma lista que ShopZones.ALLOWED (dominio). Si cambia una, cambia la otra.
      function validZone(z) {
        return z in ['America/Mexico_City', 'America/Monterrey', 'America/Merida', 'America/Cancun', 'America/Chihuahua',
          'America/Mazatlan', 'America/Hermosillo', 'America/Tijuana',
          'America/Bogota', 'America/Lima', 'America/Guatemala', 'America/Santiago', 'America/Argentina/Buenos_Aires',
          'America/New_York', 'America/Chicago', 'America/Denver', 'America/Los_Angeles', 'Europe/Madrid'];
      }

      function validTenant(data) {
        return data.keys().hasOnly(['name', 'ownerUid', 'timezone', 'createdAt', 'shareCode'])
          && isText(data.name, 1, 80)
          && data.ownerUid == tenantId
          && validZone(data.timezone);
      }

      // get sí (para reservar en una barbería conocida); list no: un script podría leer todas y gastar la cuota (H5).
      allow get: if signedIn();
      allow list: if false;
      allow create: if isSelf(tenantId)
        && validTenant(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(tenantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'timezone', 'shareCode'])
        && validTenant(request.resource.data)
        // R7: solo un código que apunte a esta barbería
        && (!('shareCode' in request.resource.data.diff(resource.data).affectedKeys())
            || getAfter(/databases/$(database)/documents/shareCodes/$(request.resource.data.shareCode)).data.tenantId == tenantId);
      allow delete: if isSelf(tenantId); // A7: el dueño cierra su barbería
    }

    // ── tenants/{ownerUid}/catalog/main ──────────────────────────────────────
    // Servicios + barberos + horarios en UN documento: el cliente lo lee con 1 lectura.
    // El contenido de cada servicio lo valida el dominio; aquí se limita forma, tamaño y versión.
    match /tenants/{tenantId}/catalog/{docId} {
      function validCatalog(data) {
        return data.keys().hasOnly(['version', 'services', 'barbers', 'updatedAt'])
          && data.services is list && data.services.size() <= 50
          && data.barbers is list && data.barbers.size() <= 20
          && data.version is int
          && data.updatedAt == request.time;
      }

      allow get: if signedIn() && docId == 'main';
      allow list: if false;
      allow create: if isSelf(tenantId) && emailVerified() && docId == 'main'
        && validCatalog(request.resource.data)
        && request.resource.data.version == 1;
      // C9: solo se guarda sobre la versión que se leyó (versión + 1).
      allow update: if isSelf(tenantId) && emailVerified()
        && validCatalog(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if isSelf(tenantId); // A7
    }

    // ── Reservas ─────────────────────────────────────────────────────────────
    // days/{barberId_fecha}.booked = { "600": "idCita", "605": "idCita", ... } (bloques de 5 min).
    // Doble reserva imposible sin servidor (B3): un bloque existente nunca se sobrescribe ni se borra
    // si no es de la cita que se cancela. `lastOp` liga cada escritura del día con su cita.
    match /tenants/{tenantId}/appointments/{apptId} {
      function dayAfter(data) {
        return getAfter(/databases/$(database)/documents/tenants/$(tenantId)/days/$(data.dayId)).data;
      }

      function isMine() {
        return signedIn() && resource.data.clientUid == request.auth.uid;
      }

      // R3: startsAt debe corresponder a la fecha y hora local de la cita (±14 h por zona horaria).
      function startsAtMatches(data) {
        let parts = data.date.split('-');
        let localStart = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
          + duration.value(data.startMinute, 'm');
        return data.startsAt >= localStart - duration.value(14, 'h')
          && data.startsAt <= localStart + duration.value(14, 'h');
      }

      // R1: los bloques corresponden a la hora y duración de la cita (máx. 8 h).
      function slotsMatch(data) {
        return data.slotKeys.size() * 5 == data.endMinute - data.startMinute
          && data.endMinute - data.startMinute <= 480
          && data.slotKeys[0] == string(data.startMinute)
          && data.slotKeys[data.slotKeys.size() - 1] == string(data.endMinute - 5);
      }

      function validNew(data) {
        return data.keys().hasOnly(['clientUid', 'clientName', 'barberId', 'barberName', 'serviceId',
            'serviceName', 'priceCents', 'date', 'startMinute', 'endMinute', 'startsAt', 'status',
            'slotKeys', 'dayId', 'createdAt', 'clientPhone'])
          && isText(data.clientName, 1, 80)
          && (isClientBooking(data) || isWalkIn(data))
          && data.status == 'BOOKED'
          && data.slotKeys is list && data.slotKeys.size() > 0 && data.slotKeys.size() <= 96
          && data.startMinute is int && data.endMinute is int && data.endMinute > data.startMinute
          && data.startsAt is timestamp
          && data.startsAt < request.time + duration.value(31, 'd') // V2: ventana de reserva
          && data.priceCents is int && data.priceCents >= 0
          && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && slotsMatch(data)
          && startsAtMatches(data)
          && data.dayId == data.barberId + '_' + data.date
          && data.createdAt == request.time
          && dayAfter(data).lastOp == apptId;
      }

      // El cliente reserva a su nombre, en el futuro y sin penalización vigente.
      function isClientBooking(data) {
        return data.clientUid == request.auth.uid
          && !('clientPhone' in data)
          && data.startsAt > request.time
          && notPenalized();
      }

      // N1: el personal agenda a un cliente sin cuenta (sin ficha: no hay penalización ni límite que esquivar).
      // Se acepta el turno que empezó hace poco (cliente que llega al local): 15 min + 5 de reloj (A11).
      function isWalkIn(data) {
        return data.clientUid == null
          && isStaffFor(data)
          && isOptionalText(data.get('clientPhone', null), 20)
          && data.startsAt > request.time - duration.value(20, 'm');
      }

      // P2: un cliente con penalización vigente no reserva (1 lectura extra por reserva).
      function notPenalized() {
        let client = /databases/$(database)/documents/tenants/$(tenantId)/clients/$(request.auth.uid);
        return !exists(client)
          || get(client).data.get('penaltyUntil', null) == null
          || get(client).data.penaltyUntil < request.time;
      }

      function isStaffFor(data) {
        return isSelf(tenantId) || isBarberOf(tenantId, data.barberId);
      }

      // F7-3: cliente con penalización vigente (para cancelar sus citas futuras con cualquier barbero).
      function clientPenalized(data) {
        let client = /databases/$(database)/documents/tenants/$(tenantId)/clients/$(data.clientUid);
        return exists(client)
          && get(client).data.get('penaltyUntil', null) != null
          && get(client).data.penaltyUntil > request.time;
      }

      // A2/A3: cliente sus citas; dueño todas; barbero las suyas (la consulta debe filtrar por barberId).
      // F7-3: cualquier personal ve las de un cliente penalizado (la consulta filtra por clientUid).
      allow get, list: if isMine() || isStaffFor(resource.data)
        || (isStaffOfTenant(tenantId) && clientPenalized(resource.data));
      allow create: if signedIn() && validNew(request.resource.data);
      // Cancelar: el cliente hasta 2 h antes (B7); el dueño cuando sea. Se liberan los bloques en el mismo batch.
      // A7: el cliente que borra su cuenta quita su nombre y su uid. Una cita que aún puede cancelar
      // se cancela antes (si no, dejaría el horario ocupado).
      function anonymizes() {
        return isMine()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientUid', 'clientName', 'updatedAt'])
          && request.resource.data.clientUid == null
          && request.resource.data.clientName == ''
          && (resource.data.status != 'BOOKED'
              || request.time >= resource.data.startsAt - duration.value(2, 'h'));
      }

      // F7-2: el dueño deshace "atendida" o "no llegó" dentro de 15 min (la ficha se corrige en el mismo batch).
      function undoesMark() {
        return resource.data.status in ['COMPLETED', 'NO_SHOW']
          && request.resource.data.status == 'BOOKED'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && isSelf(tenantId)
          && request.time < resource.data.get('updatedAt', timestamp.value(0)) + duration.value(15, 'm')
          && clientTouchedNow(resource.data);
      }

      // P7/F7-2: la ficha del cliente se escribió en ESTE batch y por esta cita (no basta que ya apuntara a ella:
      // la primera reserva crea la ficha con esta cita). N1: una cita sin cuenta no tiene ficha.
      function clientTouchedNow(data) {
        let client = getAfter(/databases/$(database)/documents/tenants/$(tenantId)/clients/$(data.clientUid)).data;
        return data.clientUid == null
          || (client.lastAppointmentId == apptId && client.updatedAt == request.time);
      }

      // F7-2: la hora del cambio la pone el servidor (el plazo de deshacer depende de ella).
      allow update: if request.resource.data.get('updatedAt', null) == request.time
        && (anonymizes() || undoesMark() || (resource.data.status == 'BOOKED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          // Cancelar (libera bloques en el mismo batch). Cliente hasta 2 h antes; personal cuando sea (A5).
          (request.resource.data.status == 'CANCELLED'
            // W4: el personal solo antes de la hora (después: atendida o no-show, para no esconder no-shows)
            && (((isStaffFor(resource.data) || (isStaffOfTenant(tenantId) && clientPenalized(resource.data)))
                  && request.time < resource.data.startsAt)
                || (isMine() && request.time < resource.data.startsAt - duration.value(2, 'h')))
            && dayAfter(resource.data).lastOp == apptId)
          ||
          // A4: completar / no-show solo el personal y después de la hora de inicio. A6: solo desde BOOKED.
          (request.resource.data.status in ['COMPLETED', 'NO_SHOW']
            && isStaffFor(resource.data)
            && request.time >= resource.data.startsAt
            // P7: la ficha del cliente se actualiza en el mismo batch (no se esquivan contadores).
            // N1: una cita sin cuenta no tiene ficha.
            && clientTouchedNow(resource.data))
        )));
      allow delete: if isSelf(tenantId); // A7
    }

    match /tenants/{tenantId}/days/{dayId} {
      function apptAfter() {
        return getAfter(/databases/$(database)/documents/tenants/$(tenantId)/appointments/$(request.resource.data.lastOp)).data;
      }

      function validShape() {
        return request.resource.data.keys().hasOnly(['booked', 'lastOp', 'updatedAt'])
          && request.resource.data.booked is map
          && request.resource.data.updatedAt == request.time;
      }

      function bookingFor(appt, status) {
        return appt.status == status && appt.dayId == dayId;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validShape()
        && request.resource.data.booked.keys().toSet() == apptAfter().slotKeys.toSet()
        && bookingFor(apptAfter(), 'BOOKED');
      allow update: if signedIn() && validShape() && (
        // Reservar: solo agrega bloques nuevos, exactamente los de la cita.
        (request.resource.data.booked.diff(resource.data.booked).changedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).removedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).addedKeys() == apptAfter().slotKeys.toSet()
          && bookingFor(apptAfter(), 'BOOKED'))
        ||
        // Cancelar: solo quita los bloques de la cita cancelada.
        (request.resource.data.booked.diff(resource.data.booked).changedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).addedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).removedKeys() == apptAfter().slotKeys.toSet()
          && bookingFor(apptAfter(), 'CANCELLED'))
      );
      allow delete: if isSelf(tenantId); // A7
    }

    // ── tenants/{t}/revoked/{uid} (A16) ──────────────────────────────────────
    // El dueño quita el acceso a la cuenta de un barbero; el barbero lo puede leer para enterarse.
    match /tenants/{tenantId}/revoked/{staffUid} {
      allow get: if isSelf(tenantId) || isSelf(staffUid);
      allow list: if isSelf(tenantId);
      allow create: if isSelf(tenantId)
        && request.resource.data.keys().hasOnly(['barberId', 'createdAt'])
        && isText(request.resource.data.barberId, 1, 64)
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      // El barbero vuelve solo con una invitación NUEVA (creada después de quitarle el acceso) que usa en el mismo batch.
      function redeemsFreshInvite() {
        let invite = getAfter(/databases/$(database)/documents/staffInvites/$(
          getAfter(/databases/$(database)/documents/users/$(staffUid)).data.get('staffInviteCode', 'none'))).data;
        return invite.tenantId == tenantId
          && invite.usedBy == staffUid
          && (resource == null || invite.createdAt > resource.data.createdAt);
      }
      allow delete: if isSelf(tenantId) || (isSelf(staffUid) && redeemsFreshInvite());
    }

    // ── shareCodes/{code} (B0) ───────────────────────────────────────────────
    // Código corto para que un cliente encuentre la barbería sin poder listarlas todas (H5).
    match /shareCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && emailVerified()
        && request.resource.data.keys().hasOnly(['tenantId', 'createdAt'])
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && code.size() == 6;
      allow update: if false;
      allow delete: if signedIn() && resource.data.tenantId == request.auth.uid; // A7
    }

    // ── tenants/{t}/clients/{uid} (fase 7) ───────────────────────────────────
    // Sin Cloud Functions: los contadores se escriben en el MISMO batch que el cambio de la cita,
    // y estas reglas verifican que solo suban de 1 en 1 según la transición real de la cita (P3, P7).
    match /tenants/{tenantId}/clients/{clientUid} {
      function prev(field) {
        return resource == null ? 0 : resource.data.get(field, 0);
      }

      function prevPenalty() {
        return resource == null ? null : resource.data.get('penaltyUntil', null);
      }

      function isTenantStaff() {
        return isStaffOfTenant(tenantId);
      }

      function validShape(d) {
        return d.keys().hasOnly(['name', 'completed', 'noShows', 'rewardsUsed', 'penaltyUntil', 'lastAppointmentId', 'updatedAt'])
          && isText(d.name, 1, 80)
          && d.completed is int && d.noShows is int && d.rewardsUsed is int
          && d.lastAppointmentId is string
          && d.updatedAt == request.time;
      }

      function apptPath(d) {
        return /databases/$(database)/documents/tenants/$(tenantId)/appointments/$(d.lastAppointmentId);
      }

      // Atendida o no-show de una cita BOOKED de este cliente, en el mismo batch.
      function marksAppointment(d) {
        let before = get(apptPath(d)).data;
        let after = getAfter(apptPath(d)).data;
        return before.status == 'BOOKED'
          && before.clientUid == clientUid
          && (isSelf(tenantId) || isBarberOf(tenantId, before.barberId))
          && d.rewardsUsed == prev('rewardsUsed')
          && (
            (after.status == 'COMPLETED'
              && d.completed == prev('completed') + 1
              && d.noShows == prev('noShows')
              && d.penaltyUntil == prevPenalty())
            ||
            (after.status == 'NO_SHOW'
              && d.completed == prev('completed')
              && d.noShows == prev('noShows') + 1
              // P1: penalización máximo 14 días (+5 min de reloj, A11)
              && (d.penaltyUntil == prevPenalty()
                  // F7-1: solo en múltiplos de 3 (3, 6, 9…)
                  || (d.noShows % 3 == 0 && d.penaltyUntil is timestamp
                      && d.penaltyUntil <= request.time + duration.value(14, 'd') + duration.value(5, 'm'))))
          );
      }

      // F7-2: deshacer (solo el dueño): la cita vuelve a BOOKED en el mismo batch y se resta lo que sumó.
      function undoesMark(d) {
        let before = get(apptPath(d)).data;
        let after = getAfter(apptPath(d)).data;
        return resource != null && isSelf(tenantId)
          && before.clientUid == clientUid
          && after.status == 'BOOKED'
          && d.rewardsUsed == prev('rewardsUsed')
          && (
            (before.status == 'COMPLETED'
              && d.completed == prev('completed') - 1
              && d.noShows == prev('noShows')
              && d.penaltyUntil == prevPenalty()
              && d.rewardsUsed * 10 <= d.completed) // no si ya canjeó un premio con esa visita
            ||
            (before.status == 'NO_SHOW'
              && d.completed == prev('completed')
              && d.noShows == prev('noShows') - 1
              // si esa falta fue la que penalizó (3, 6, 9…), se quita la penalización
              && (d.penaltyUntil == prevPenalty() || (prev('noShows') % 3 == 0 && d.penaltyUntil == null)))
          );
      }

      // P4: canjear un premio (cada 10 visitas). F7-8: solo el dueño.
      function redeemsReward(d) {
        return resource != null && isSelf(tenantId)
          && d.completed == prev('completed') && d.noShows == prev('noShows') && d.penaltyUntil == prevPenalty()
          && d.rewardsUsed == prev('rewardsUsed') + 1
          && d.rewardsUsed * 10 <= d.completed;
      }

      // P5: solo el dueño perdona: quita la penalización y reinicia los no-shows.
      function forgives(d) {
        return resource != null && isSelf(tenantId)
          && d.completed == prev('completed') && d.rewardsUsed == prev('rewardsUsed')
          && d.noShows == 0 && d.penaltyUntil == null;
      }

      // F7-6: el cliente crea su propia ficha (en ceros) en el mismo batch de su primera reserva.
      function createdAtFirstBooking(d) {
        return resource == null
          && signedIn() && request.auth.uid == clientUid
          && d.completed == 0 && d.noShows == 0 && d.rewardsUsed == 0 && d.penaltyUntil == null
          && !exists(apptPath(d))
          && getAfter(apptPath(d)).data.clientUid == clientUid
          && getAfter(apptPath(d)).data.status == 'BOOKED';
      }

      allow get: if (signedIn() && request.auth.uid == clientUid) || isTenantStaff();
      allow list: if isSelf(tenantId);
      allow create, update: if validShape(request.resource.data) && (
        createdAtFirstBooking(request.resource.data) ||
        redeemsReward(request.resource.data)
        || forgives(request.resource.data)
        || (exists(apptPath(request.resource.data)) && marksAppointment(request.resource.data))
        || (exists(apptPath(request.resource.data)) && undoesMark(request.resource.data))
      );
      // A7: el cliente borra su ficha al eliminar su cuenta; el dueño, al cerrar la barbería.
      allow delete: if (signedIn() && request.auth.uid == clientUid) || isSelf(tenantId);
    }

    // ── staffInvites/{code} (A1) ─────────────────────────────────────────────
    match /staffInvites/{code} {
      allow get: if signedIn();
      // A7: el dueño lista las suyas para borrarlas (la consulta filtra por tenantId).
      allow list: if signedIn() && resource.data.tenantId == request.auth.uid;
      allow create: if signedIn() && emailVerified()
        && isSelf(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['tenantId', 'barberId', 'barberName', 'createdAt', 'expiresAt', 'usedBy'])
        && request.resource.data.usedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        // A11: 7 días + 5 min de tolerancia por el reloj del teléfono (puede ir adelantado).
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm')
        && code.size() == 6;
      // Se usa una sola vez, antes de vencer, y junto con el perfil de quien la usa.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffInviteCode == code;
      allow delete: if signedIn() && resource.data.tenantId == request.auth.uid; // A7
    }

    // ── A7: citas propias en todas las barberías (consulta de grupo) ─────────
    // Solo para encontrarlas al eliminar la cuenta; la consulta debe filtrar por clientUid.
    match /{path=**}/appointments/{apptId} {
      allow list: if signedIn() && resource.data.clientUid == request.auth.uid;
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
