rules_version = '2';

// Reglas pensadas para el plan Spark:
// - tenants/{id} usa el uid del dueño como id → "¿es el dueño?" se responde sin leer documentos.
// - Cada get()/exists()/getAfter() en una regla cuenta como una lectura; solo se usan donde no hay otra opción.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isText(value, min, max) {
      return value is string && value.size() >= min && value.size() <= max;
    }

    function isOptionalText(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    // Perfil de quien hace la petición (1 lectura, se reutiliza dentro de la misma petición).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // A2: barbero ligado a esta barbería y a este barbero del catálogo.
    function isBarberOf(tenantId, barberId) {
      return signedIn()
        && myProfile().get('staffRole', null) == 'BARBER'
        && myProfile().get('staffTenantId', null) == tenantId
        && myProfile().get('staffBarberId', null) == barberId;
    }

    // ── users/{uid} ──────────────────────────────────────────────────────────
    match /users/{uid} {
      function validProfile(data) {
        return data.keys().hasOnly(['displayName', 'email', 'phone', 'staffTenantId', 'staffRole', 'createdAt'])
          && isText(data.displayName, 1, 80)
          && data.email == request.auth.token.email
          && isOptionalText(data.phone, 20)
          && data.createdAt == request.time;
      }

      // Cliente: sin rol. Dueño: su propia barbería, creada en el mismo batch (A9).
      // Nadie puede darse el rol de barbero: eso lo hará el dueño (fase 4).
      function validRole(data) {
        return (data.staffRole == null && data.staffTenantId == null)
          || (data.staffRole == 'OWNER'
              && data.staffTenantId == uid
              && getAfter(/databases/$(database)/documents/tenants/$(uid)).data.ownerUid == uid);
      }

      allow read: if isSelf(uid);
      allow create: if isSelf(uid) && validProfile(request.resource.data) && validRole(request.resource.data);
      function inviteAfter() {
        return getAfter(/databases/$(database)/documents/staffInvites/$(request.resource.data.staffInviteCode)).data;
      }

      // A1/A8: un cliente (sin rol) se vuelve barbero solo con una invitación válida que usa en el mismo batch.
      function redeemsInvite() {
        return resource.data.staffRole == null
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['staffTenantId', 'staffRole', 'staffBarberId', 'staffInviteCode'])
          && request.resource.data.staffRole == 'BARBER'
          && inviteAfter().usedBy == uid
          && inviteAfter().tenantId == request.resource.data.staffTenantId
          && inviteAfter().barberId == request.resource.data.staffBarberId;
      }

      allow update: if isSelf(uid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'phone'])
          && isText(request.resource.data.displayName, 1, 80)
          && isOptionalText(request.resource.data.phone, 20))
        || redeemsInvite()
      );
      allow delete: if false; // Fase 9: eliminar cuenta
    }

    // ── tenants/{ownerUid} ───────────────────────────────────────────────────
    match /tenants/{tenantId} {
      function validTenant(data) {
        return data.keys().hasOnly(['name', 'ownerUid', 'timezone', 'createdAt', 'shareCode'])
          && isText(data.name, 1, 80)
          && data.ownerUid == tenantId
          && isText(data.timezone, 3, 64);
      }

      // get sí (para reservar en una barbería conocida); list no: un script podría leer todas y gastar la cuota (H5).
      allow get: if signedIn();
      allow list: if false;
      allow create: if isSelf(tenantId)
        && validTenant(request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(tenantId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'timezone', 'shareCode'])
        && validTenant(request.resource.data)
        // R7: solo un código que apunte a esta barbería
        && (!('shareCode' in request.resource.data.diff(resource.data).affectedKeys())
            || getAfter(/databases/$(database)/documents/shareCodes/$(request.resource.data.shareCode)).data.tenantId == tenantId);
      allow delete: if false;
    }

    // ── tenants/{ownerUid}/catalog/main ──────────────────────────────────────
    // Servicios + barberos + horarios en UN documento: el cliente lo lee con 1 lectura.
    // El contenido de cada servicio lo valida el dominio; aquí se limita forma, tamaño y versión.
    match /tenants/{tenantId}/catalog/{docId} {
      function validCatalog(data) {
        return data.keys().hasOnly(['version', 'services', 'barbers', 'updatedAt'])
          && data.services is list && data.services.size() <= 50
          && data.barbers is list && data.barbers.size() <= 20
          && data.version is int
          && data.updatedAt == request.time;
      }

      allow get: if signedIn() && docId == 'main';
      allow list: if false;
      allow create: if isSelf(tenantId) && docId == 'main'
        && validCatalog(request.resource.data)
        && request.resource.data.version == 1;
      // C9: solo se guarda sobre la versión que se leyó (versión + 1).
      allow update: if isSelf(tenantId)
        && validCatalog(request.resource.data)
        && request.resource.data.version == resource.data.version + 1;
      allow delete: if false;
    }

    // ── Reservas ─────────────────────────────────────────────────────────────
    // days/{barberId_fecha}.booked = { "600": "idCita", "605": "idCita", ... } (bloques de 5 min).
    // Doble reserva imposible sin servidor (B3): un bloque existente nunca se sobrescribe ni se borra
    // si no es de la cita que se cancela. `lastOp` liga cada escritura del día con su cita.
    match /tenants/{tenantId}/appointments/{apptId} {
      function dayAfter(data) {
        return getAfter(/databases/$(database)/documents/tenants/$(tenantId)/days/$(data.dayId)).data;
      }

      function isMine() {
        return signedIn() && resource.data.clientUid == request.auth.uid;
      }

      // R3: startsAt debe corresponder a la fecha y hora local de la cita (±14 h por zona horaria).
      function startsAtMatches(data) {
        let parts = data.date.split('-');
        let localStart = timestamp.date(int(parts[0]), int(parts[1]), int(parts[2]))
          + duration.value(data.startMinute, 'm');
        return data.startsAt >= localStart - duration.value(14, 'h')
          && data.startsAt <= localStart + duration.value(14, 'h');
      }

      // R1: los bloques corresponden a la hora y duración de la cita (máx. 8 h).
      function slotsMatch(data) {
        return data.slotKeys.size() * 5 == data.endMinute - data.startMinute
          && data.endMinute - data.startMinute <= 480
          && data.slotKeys[0] == string(data.startMinute)
          && data.slotKeys[data.slotKeys.size() - 1] == string(data.endMinute - 5);
      }

      function validNew(data) {
        return data.keys().hasOnly(['clientUid', 'clientName', 'barberId', 'barberName', 'serviceId',
            'serviceName', 'priceCents', 'date', 'startMinute', 'endMinute', 'startsAt', 'status',
            'slotKeys', 'dayId', 'createdAt'])
          && data.clientUid == request.auth.uid
          && data.status == 'BOOKED'
          && data.slotKeys is list && data.slotKeys.size() > 0 && data.slotKeys.size() <= 96
          && data.startMinute is int && data.endMinute is int && data.endMinute > data.startMinute
          && data.startsAt is timestamp && data.startsAt > request.time
          && data.startsAt < request.time + duration.value(31, 'd') // V2: ventana de reserva
          && data.priceCents is int && data.priceCents >= 0
          && data.date is string && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && slotsMatch(data)
          && startsAtMatches(data)
          && data.dayId == data.barberId + '_' + data.date
          && data.createdAt == request.time
          && dayAfter(data).lastOp == apptId;
      }

      function isStaffFor(data) {
        return isSelf(tenantId) || isBarberOf(tenantId, data.barberId);
      }

      // A2/A3: cliente sus citas; dueño todas; barbero las suyas (la consulta debe filtrar por barberId).
      allow get, list: if isMine() || isStaffFor(resource.data);
      allow create: if signedIn() && validNew(request.resource.data);
      // Cancelar: el cliente hasta 2 h antes (B7); el dueño cuando sea. Se liberan los bloques en el mismo batch.
      allow update: if resource.data.status == 'BOOKED'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          // Cancelar (libera bloques en el mismo batch). Cliente hasta 2 h antes; personal cuando sea (A5).
          (request.resource.data.status == 'CANCELLED'
            // W4: el personal solo antes de la hora (después: atendida o no-show, para no esconder no-shows)
            && ((isStaffFor(resource.data) && request.time < resource.data.startsAt)
                || (isMine() && request.time < resource.data.startsAt - duration.value(2, 'h')))
            && dayAfter(resource.data).lastOp == apptId)
          ||
          // A4: completar / no-show solo el personal y después de la hora de inicio. A6: solo desde BOOKED.
          (request.resource.data.status in ['COMPLETED', 'NO_SHOW']
            && isStaffFor(resource.data)
            && request.time >= resource.data.startsAt)
        );
      allow delete: if false;
    }

    match /tenants/{tenantId}/days/{dayId} {
      function apptAfter() {
        return getAfter(/databases/$(database)/documents/tenants/$(tenantId)/appointments/$(request.resource.data.lastOp)).data;
      }

      function validShape() {
        return request.resource.data.keys().hasOnly(['booked', 'lastOp', 'updatedAt'])
          && request.resource.data.booked is map
          && request.resource.data.updatedAt == request.time;
      }

      function bookingFor(appt, status) {
        return appt.status == status && appt.dayId == dayId;
      }

      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validShape()
        && request.resource.data.booked.keys().toSet() == apptAfter().slotKeys.toSet()
        && bookingFor(apptAfter(), 'BOOKED');
      allow update: if signedIn() && validShape() && (
        // Reservar: solo agrega bloques nuevos, exactamente los de la cita.
        (request.resource.data.booked.diff(resource.data.booked).changedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).removedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).addedKeys() == apptAfter().slotKeys.toSet()
          && bookingFor(apptAfter(), 'BOOKED'))
        ||
        // Cancelar: solo quita los bloques de la cita cancelada.
        (request.resource.data.booked.diff(resource.data.booked).changedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).addedKeys().size() == 0
          && request.resource.data.booked.diff(resource.data.booked).removedKeys() == apptAfter().slotKeys.toSet()
          && bookingFor(apptAfter(), 'CANCELLED'))
      );
      allow delete: if false;
    }

    // ── shareCodes/{code} (B0) ───────────────────────────────────────────────
    // Código corto para que un cliente encuentre la barbería sin poder listarlas todas (H5).
    match /shareCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tenantId', 'createdAt'])
        && request.resource.data.tenantId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && code.size() == 6;
      allow update, delete: if false;
    }

    // ── staffInvites/{code} (A1) ─────────────────────────────────────────────
    match /staffInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && isSelf(request.resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['tenantId', 'barberId', 'barberName', 'createdAt', 'expiresAt', 'usedBy'])
        && request.resource.data.usedBy == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt > request.time
        // A11: 7 días + 5 min de tolerancia por el reloj del teléfono (puede ir adelantado).
        && request.resource.data.expiresAt <= request.time + duration.value(7, 'd') + duration.value(5, 'm')
        && code.size() == 6;
      // Se usa una sola vez, antes de vencer, y junto con el perfil de quien la usa.
      allow update: if signedIn()
        && resource.data.usedBy == null
        && request.time < resource.data.expiresAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy'])
        && request.resource.data.usedBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffInviteCode == code;
      allow delete: if false;
    }

    // Todo lo que no esté declarado arriba queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
