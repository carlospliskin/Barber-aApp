root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
ktlint_code_style = android_studio
# Compose: las funciones @Composable empiezan con mayúscula.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Estilo propio del proyecto: varias clases pequeñas por archivo (estado, intents y ViewModel juntos).
ktlint_standard_filename = disabled
ktlint_standard_no-wildcard-imports = disabled
